# Copy this file to .env and fill it in. Only FLUXER_TOKEN is required.
# Everything else has a working default, or turns its feature off when empty.

# --- Fluxer ----------------------------------------------------------------
# Your bot's token, from Fluxer's developer settings.
FLUXER_TOKEN=
# Only for a self-hosted Fluxer instance.
# FLUXER_API_URL=
# FLUXER_WEB_BASE=https://web.fluxer.app

# --- Who the bot is ---------------------------------------------------------
# The name used in prompts, transcripts and replies. If you change it, also
# edit the persona (persona/SOUL.md, and ollama/Modelfile if you use it).
BOT_NAME=Corbin
# Your own Fluxer user id. Unlocks the owner-only commands, which act on the
# bot itself (leave, servers, chatban, the voice/streaming allowlist). It
# gives NO permissions inside servers: there you need that server's own
# roles like anyone else. Empty = nobody is the owner.
BOT_OWNER_ID=
# The bot's own custom emoji. The persona writes :BOT_EMOJI_NAME:, and this
# id is what that expands to. Upload the emoji to a server the bot is in.
BOT_EMOJI_NAME=corbin
BOT_EMOJI_ID=
# A channel for startup reports and the daily usage digest. Optional.
LOG_CHANNEL_ID=

# --- The model --------------------------------------------------------------
# Any OpenAI-compatible endpoint: Ollama, LM Studio, llama.cpp server, vLLM.
LLM_URL=http://localhost:11434/v1
# The model that talks. With ollama/Modelfile, the name you gave `ollama create`.
LLM_MODEL=corbin
# Optional smaller model for command detection and memory extraction, which
# run on most messages. Defaults to LLM_MODEL.
# LLM_FAST_MODEL=
# 1 if the persona is baked into the model (ollama/Modelfile). 0 sends
# persona/SOUL.md as the system prompt, which works with any model.
LLM_PERSONA_IN_MODEL=0
# 1 only if the model can see images (llava, qwen2.5-vl, gemma3, ...).
LLM_VISION=0
# MAX_VISION_IMAGES=2
# Offer the model a tool to look up the bot's own commands.
LLM_TOOLS=1
# Sampling overrides. Empty uses the model's own settings. Qwen models loop
# without a presence penalty; 1.5 is Qwen's recommendation.
# LLM_TEMPERATURE=
# LLM_PRESENCE_PENALTY=
# LLM_PROBE_TIMEOUT=5

# --- Persona ----------------------------------------------------------------
# PERSONA_PATH=persona/SOUL.md
# PERSONA_ADDITIONS_PATH=persona/SOUL_ADDITIONS.md

# --- Behaviour --------------------------------------------------------------
# Unprompted thoughts in servers set to global mode (up to 3 a day).
MUSINGS=1
# MUSINGS_TIMEZONE=America/Los_Angeles
# Channel ids where he answers everything. Usually set from chat instead.
# AI_CHANNELS=
# Request presence updates. Leave off unless you know you need it: if the
# server rejects the intent, the bot cannot connect at all.
PRESENCE_INTENT=0
# INFO keeps what people write out of the log (only its length). DEBUG
# logs the text too: use it for a short debugging session only.
# LOG_LEVEL=INFO
# Log file, rotated at midnight (UTC), kept LOG_DAYS days. Empty: stderr only.
# LOG_FILE=logs/bot.log
# LOG_DAYS=14

# --- State ------------------------------------------------------------------
# Memories, XP, settings, bans and reminders live here.
# DATA_ROOT=data
# Encrypt memories, warnings and reminders at rest (needs
# `pip install cryptography`). Make a key with
# `python tools/encrypt_data.py --new-key`, put it in a file OUTSIDE this
# folder (chmod 600) and point DATA_KEY_FILE at it; keep a copy elsewhere,
# since without it that data is unreadable. DATA_KEY holds the key itself
# instead. Both empty: plain JSON. Existing files are encrypted as they're
# next saved, or all at once with tools/encrypt_data.py.
# DATA_KEY_FILE=
# DATA_KEY=

# --- Voice chat (VoiceStudio) ---------------------------------------------------
# Spoken conversation in voice channels ("<name>, talk with me in voice").
# Needs VoiceStudio (https://github.com/debpalash/VoiceStudio) running on
# this host with a speech-recognition and a voice engine installed. Checked
# at boot and whenever voice chat starts; when it's down, voice chat is off.
# VOICE_CHAT=1
# Voice chat and streaming only work in servers on the owner's allowlist.
# DM the bot (as BOT_OWNER_ID): "add <server id> to the allowlist for
# voice" (or "for streaming"). This seeds the voice list once, on first
# boot only; after that the DM command is the source of truth.
VOICE_CHAT_GUILDS=
# VOICESTUDIO_URL=http://127.0.0.1:3900
# VOICESTUDIO_API_KEY=
# A voice-profile id or name from VoiceStudio (GET /v1/audio/voices).
# VOICESTUDIO_VOICE=default
# An installed engine id, or tts-1 for the active one.
# VOICESTUDIO_TTS_MODEL=tts-1
# Language hint for transcription, e.g. en. Empty: auto-detect.
# VOICESTUDIO_LANGUAGE=
# Effect on his voice: raven (pitched-up, nasal, a light croak and grit),
# off, or your own ffmpeg audio filter chain.
# VOICE_FX=raven
# OmniVoice steps per line (32 quality, 16 faster).
# VOICESTUDIO_STEPS=32
# Transcribe while people talk (streaming socket). Run
# tools/check_voicestudio.py first; it says whether this is worth turning on.
# VOICE_STREAM_STT=0
# VOICESTUDIO_STT_MODEL=
# The person he's answering can cut him off by talking over him.
# VOICE_BARGE_IN=1
# Real raven calls where a spoken reply says *caw*: a file or a folder of
# audio files. Missing: he says the word.
# CAW_SOUNDS=data/caws
# CAW_CHANCE=0.2

# --- Streaming video (screen share) -----------------------------------------
# Music videos, live TV and your own video library, streamed into a voice
# channel. Needs the voice extra and ffmpeg, and a server on the owner's
# allowlist for streaming (see above). Nothing streams until then.
# Live TV catalogue from iptv-org (downloaded daily, only while some server
# allows streaming). 0 turns it off.
# IPTV=1
# One folder per show (seasons as subfolders); a video straight in the
# folder is a film. Missing folder: no videos.
# VIDEO_ROOT=data/video
# Default TV watch limit in minutes (0 = none); servers can set their own.
# TV_MAX_MINUTES=0
# 1080p needs a strong CPU (a 1080p encode can take a whole core).
# ALLOW_1080P=0
# STREAM_QUALITY=720p
# The "12:34 / 24:02" timer in the corner of music videos and videos.
# STREAM_TIMER=1

# --- Optional features --------------------------------------------------------
# Weather and weather alerts (openweathermap.org).
WEATHER_API_KEY=
# Image search (Google Programmable Search).
GOOGLE_API_KEY=
CSE_ID=
# Spotify links in the music player.
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=
# copy_emojis: copy a Discord server's emojis and stickers into Fluxer.
DISCORD_TOKEN=
DISCORD_GUILD_ID=
# Level-up announcement image (a URL).
# LEVEL_UP_IMAGE=
# Custom rank roles, as JSON: {"1": ["Newcomer", "#FFFFFF"], "25": ["Regular", "#808080"]}
# RANK_ROLES_FILE=
# Radio station. Defaults to 975 KZLF.
# RADIO_NAME=
# RADIO_STREAM_URL=
# RADIO_NOW_PLAYING_URL=
# Moon phases need de421.bsp; looked for in DATA_ROOT and beside bot.py.
# EPHEMERIS_PATH=
# Bible commentary database, built by tools/build_gill_db.py.
# GILL_DB_PATH=data/gill_commentary.sqlite
# YouTube: an exported cookies file, and a PO token provider, if playback
# hits YouTube's bot check.
# YTDL_COOKIEFILE=
# POT_PROVIDER_URL=http://127.0.0.1:4416
