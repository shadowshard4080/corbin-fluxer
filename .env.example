# Copy this file to .env and fill it in. Only FLUXER_TOKEN is required.
# Everything else has a working default, or turns its feature off when empty.

# --- Fluxer ----------------------------------------------------------------
# Your bot's token, from Fluxer's developer settings.
FLUXER_TOKEN=
# Only for a self-hosted Fluxer instance.
# FLUXER_API_URL=
# FLUXER_WEB_BASE=https://web.fluxer.app

# --- Who the bot is ---------------------------------------------------------
# The name used in prompts, transcripts and replies. If you change it, also
# edit the persona (persona/SOUL.md, and ollama/Modelfile if you use it).
BOT_NAME=Corbin
# Your own Fluxer user id. Unlocks owner-only commands (echo, leave, verify)
# and skips permission checks for you. Empty = nobody is the owner.
BOT_OWNER_ID=
# The bot's own custom emoji. The persona writes :BOT_EMOJI_NAME:, and this
# id is what that expands to. Upload the emoji to a server the bot is in.
BOT_EMOJI_NAME=corbin
BOT_EMOJI_ID=
# A channel for startup reports and the daily usage digest. Optional.
LOG_CHANNEL_ID=

# --- The model --------------------------------------------------------------
# Any OpenAI-compatible endpoint: Ollama, LM Studio, llama.cpp server, vLLM.
LLM_URL=http://localhost:11434/v1
# The model that talks. With ollama/Modelfile, the name you gave `ollama create`.
LLM_MODEL=corbin
# Optional smaller model for command detection and memory extraction, which
# run on most messages. Defaults to LLM_MODEL.
# LLM_FAST_MODEL=
# 1 if the persona is baked into the model (ollama/Modelfile). 0 sends
# persona/SOUL.md as the system prompt, which works with any model.
LLM_PERSONA_IN_MODEL=0
# 1 only if the model can see images (llava, qwen2.5-vl, gemma3, ...).
LLM_VISION=0
# MAX_VISION_IMAGES=2
# Offer the model a tool to look up the bot's own commands.
LLM_TOOLS=1
# Sampling overrides. Empty uses the model's own settings. Qwen models loop
# without a presence penalty; 1.5 is Qwen's recommendation.
# LLM_TEMPERATURE=
# LLM_PRESENCE_PENALTY=
# LLM_PROBE_TIMEOUT=5

# --- Persona ----------------------------------------------------------------
# PERSONA_PATH=persona/SOUL.md
# PERSONA_ADDITIONS_PATH=persona/SOUL_ADDITIONS.md

# --- Behaviour --------------------------------------------------------------
# Unprompted thoughts in servers set to global mode (up to 3 a day).
MUSINGS=1
# MUSINGS_TIMEZONE=America/Los_Angeles
# Channel ids where he answers everything. Usually set from chat instead.
# AI_CHANNELS=
# Request presence updates. Leave off unless you know you need it: if the
# server rejects the intent, the bot cannot connect at all.
PRESENCE_INTENT=0
# LOG_LEVEL=INFO

# --- State ------------------------------------------------------------------
# Memories, XP, settings, bans and reminders live here.
# DATA_ROOT=data

# --- Optional features --------------------------------------------------------
# Weather and weather alerts (openweathermap.org).
WEATHER_API_KEY=
# Image search (Google Programmable Search).
GOOGLE_API_KEY=
CSE_ID=
# Spotify links in the music player.
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=
# copy_emojis: copy a Discord server's emojis and stickers into Fluxer.
DISCORD_TOKEN=
DISCORD_GUILD_ID=
# Level-up announcement image (a URL).
# LEVEL_UP_IMAGE=
# Custom rank roles, as JSON: {"1": ["Newcomer", "#FFFFFF"], "25": ["Regular", "#808080"]}
# RANK_ROLES_FILE=
# Radio station. Defaults to 975 KZLF.
# RADIO_NAME=
# RADIO_STREAM_URL=
# RADIO_NOW_PLAYING_URL=
# Moon phases need de421.bsp; looked for in DATA_ROOT and beside bot.py.
# EPHEMERIS_PATH=
# Bible commentary database, built by tools/build_gill_db.py.
# GILL_DB_PATH=data/gill_commentary.sqlite
# YouTube: an exported cookies file, and a PO token provider, if playback
# hits YouTube's bot check.
# YTDL_COOKIEFILE=
# POT_PROVIDER_URL=http://127.0.0.1:4416
